<% html_title l(:label_stats) %>
<%= javascript_include_tag "vega.min", "vega-lite.min", "vega-embed.min", plugin: "redmine_rubylode_stats" %>

<h2><%= l(:label_stats) %></h2>

<% @chart_specifications.each do |chart_name, specification| %>
  <div id="stats-chart-<%= chart_name %>" class="stats-chart"></div>
  <%= javascript_tag "vegaEmbed('#stats-chart-#{chart_name}', #{specification.to_json}, { actions: false });" %>
<% end %>
