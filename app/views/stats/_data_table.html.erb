<%# The figures of a chart as a table, for keyboard and screen reader users and for anyone who wants the exact numbers. %>
<% table = chart.data_table %>
<% if table %>
  <details id="stats-data-<%= chart.chart_name %>" class="stats-data">
    <summary><%= l(:label_stats_view_data) %></summary>
    <table class="list stats-data-table">
      <caption class="stats-visually-hidden"><%= l(:label_stats_data_caption, chart: chart.card_title) %></caption>
      <thead>
        <tr><% table.headers.each do |header| %><th scope="col"><%= header %></th><% end %></tr>
      </thead>
      <tbody>
        <% table.rows.each do |row| %>
          <tr>
            <% row.cells.each_with_index do |cell, index| %>
              <% if index.zero? %><th scope="row"><%= cell %></th><% else %><td><%= cell %></td><% end %>
            <% end %>
            <td>
              <% row.links.each do |text, address| %>
                <%= link_to text, address, class: "stats-data-link", "aria-label": "#{text}: #{row.cells.first}" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </details>
<% end %>
