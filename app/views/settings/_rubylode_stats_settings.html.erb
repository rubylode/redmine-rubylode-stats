<%# Rubylode Stats: Administration, Plugins, Configure. The values are checked in RubylodeStats::SettingsControllerPatch before they are saved. %>
<% current = RubylodeStats::Settings.new(settings) %>
<% typed = settings.to_h.stringify_keys %>
<p>
  <label for="settings_palette_preset"><%= l("rubylode_stats.settings.palette_preset.label") %></label>
  <%= select_tag "settings[palette_preset]",
                 options_for_select(RubylodeStats::Settings::PRESET_CHOICES.map { |choice| [l("rubylode_stats.settings.palette_preset.choices.#{choice}"), choice] }, current.palette_preset),
                 id: "settings_palette_preset" %>
  <em class="info"><%= l("rubylode_stats.settings.palette_preset.hint") %></em>
</p>
<p>
  <label for="settings_custom_colors"><%= l("rubylode_stats.settings.custom_colors.label") %></label>
  <%= text_field_tag "settings[custom_colors]", typed.fetch("custom_colors", ""), id: "settings_custom_colors", size: 60, placeholder: "#1e88e5, #ea6a00, #00897b" %>
  <em class="info"><%= l("rubylode_stats.settings.custom_colors.hint") %></em>
</p>
<% %w[open closed neutral].each do |role| %>
  <p>
    <label for="settings_custom_<%= role %>_color"><%= l("rubylode_stats.settings.custom_#{role}_color.label") %></label>
    <%= text_field_tag "settings[custom_#{role}_color]", typed.fetch("custom_#{role}_color", ""), id: "settings_custom_#{role}_color", size: 10 %>
    <em class="info"><%= l("rubylode_stats.settings.custom_#{role}_color.hint") %></em>
  </p>
<% end %>
